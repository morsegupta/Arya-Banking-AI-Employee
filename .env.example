# Sandbox company: Sharma Distributors. All values are sandbox-only test values.
# Copy to .env and adjust. Never commit .env.

# LLMs via Groq (OpenAI-compatible). Put your real key only in .env.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Where the sandbox keeps its databases, drive files and clock.
SANDBOX_VAR_DIR=var

# Mini ERP
ERP_PORT=8101
ERP_WEB_USER=ar.clerk
ERP_WEB_PASSWORD=erp-sandbox-pass
ERP_API_KEY=erp-sandbox-readonly-key

# Bank portal (web only, read-only role)
BANK_PORT=8102
BANK_USER_ID=SHARMA001
BANK_PASSWORD=bank-sandbox-pass
BANK_SESSION_TTL_SECONDS=300

# Message hub (fake email + WhatsApp)
HUB_PORT=8103
HUB_ARYA_TOKEN=hub-arya-token
HUB_SIM_TOKEN=hub-sim-token

# Sandbox-internal admin token. Used ONLY by the payment engine / chaos tooling.
# The agent runtime must never receive this value.
SANDBOX_ADMIN_TOKEN=sandbox-admin-token
